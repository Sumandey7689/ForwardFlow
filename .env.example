# Application Ports & Environment
PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000

# Database Configuration (MySQL 8)
DATABASE_URL="mysql://root:secure_mysql_password@mysql:3306/whatsapp_forwarder_saas"
MYSQL_ROOT_PASSWORD=secure_mysql_password
MYSQL_DATABASE=whatsapp_forwarder_saas
PMA_PORT=8085

# Redis Configuration (BullMQ & Caching)
REDIS_URL="redis://redis:6379"

# Security & Secrets
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_64_character_cryptographically_secure_random_string
# Must be exactly 64 hex characters (32 bytes) for AES-256-GCM
SESSION_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Storage Paths
MEDIA_TEMP_DIR=/app/temp_media
WHATSAPP_SESSIONS_DIR=/app/sessions
LOG_LEVEL=info
